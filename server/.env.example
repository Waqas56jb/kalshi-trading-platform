# ---------------------------------------------------------------------------
# Copy to .env and fill in. This file is committed; .env is not.
#
# On Vercel set these in the project's Environment Variables instead — the
# backend project's Root Directory must be `server`.
# ---------------------------------------------------------------------------

# ---- Local only (Vercel supplies its own) ----
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Kalshi ----
# Production: https://api.elections.kalshi.com/trade-api/v2
# Demo:       https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=

# Locally the key is read from a file. On Vercel there is nowhere to keep one:
# set KALSHI_PRIVATE_KEY to the full PEM instead and leave the PATH unset.
# Setting the PATH on a serverless host makes every route fail at module load.
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>

# Runtime uses the TRANSACTION pooler (port 6543). Session mode (5432) caps the
# whole project at 15 clients, which serverless containers plus cron exhaust.
# Percent-encode special characters in the password: ! becomes %21
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Migrations want a session connection for DDL and advisory locks.
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Every table this project owns carries this prefix, so it cannot collide with
# anything already in the database.
DB_TABLE_PREFIX=kalshi_

# ---- Auth ----
# Signs session tokens. Any long random string; changing it logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Guards the cron endpoints (/api/sync, /api/schedule/sync, /api/trades/*).
CRON_SECRET=

# Used once by `node cli/users.js seed` to create the first administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Optional ----
# Kalshi series to trade. Defaults to ITF men's + women's singles.
SERIES_TICKERS=KXITFMATCH,KXITFWMATCH
# Local sync loop interval. Ignored on Vercel, where Cron drives sync.
POLL_INTERVAL_MS=15000

# ---- Not read by the backend ----
# Strategy values live in the kalshi_settings table and are edited in the UI,
# not here: min_edge_cents, min_ev_threshold, stake_per_trade, paper_trading,
# prematch_only, auto_sell_at_fair and the rest.
