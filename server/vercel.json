{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "outputDirectory": "public",

  "functions": {
    "api/**": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "crons": [
    { "path": "/api/sync", "schedule": "0 6 * * *" },
    { "path": "/api/ratings/backfill?limit=60", "schedule": "30 6 * * *" }
  ]
}
