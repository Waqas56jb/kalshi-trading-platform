{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'no build step — serverless functions only'",
  "installCommand": "npm install --omit=dev",

  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ],

  "crons": [
    { "path": "/api/sync", "schedule": "0 6 * * *" },
    { "path": "/api/ratings/backfill?limit=60", "schedule": "30 6 * * *" }
  ]
}
