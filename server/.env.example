PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Kalshi ----
# Production: https://api.elections.kalshi.com/trade-api/v2
# Demo:       https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Session pooler. Escape special characters in the password (! -> %21).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Every table this project owns carries this prefix.
DB_TABLE_PREFIX=kalshi_

MIN_EV_THRESHOLD=8
STAKE_PER_TRADE=250
MAX_EXPOSURE_PER_MATCH=600
POLL_INTERVAL_MS=15000
SERIES_TICKERS=KXITFMATCH,KXITFWMATCH
