# Copy to .env for local development. This file is committed; .env is not.

# Base URL of the CourtEdge backend.
#   local      http://localhost:8787
#   production https://kalshi-trading-platform-backend.vercel.app
#
# Vite bakes this into the bundle at build time, so changing it on Vercel
# requires a redeploy — editing the variable alone does nothing.
VITE_API_URL=http://localhost:8787

# Do NOT set NODE_ENV here. npm then skips devDependencies, vite disappears and
# the build fails with "vite: command not found".
